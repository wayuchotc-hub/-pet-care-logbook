<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>🐾 Pet Care Logbook</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #fff8f0; color: #5a4638; padding: 30px; margin: 0; }
        .container { max-width: 900px; margin: auto; text-align: center; }
        h1 { color: #ff758f; }
        .btn { background: #ff758f; color: white; padding: 10px 20px; border-radius: 20px; text-decoration: none; font-weight: bold; display: inline-block; margin-bottom: 20px; }
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
        .pet-card { background: #ffffff; border-radius: 20px; padding: 15px; border: 2px solid #ffccd5; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .pet-img { width: 100%; height: 160px; object-fit: cover; border-radius: 15px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🐾 สมุดบันทึกสัตว์เลี้ยงสุดน่ารัก</h1>
        <a href="/add-pet" class="btn">+ เพิ่มน้องๆ เข้าบ้าน</a>
        <div class="card-grid">
            <% pets.forEach(pet => { %>
                <div class="pet-card">
                    <img src="<%= pet.image || 'https://via.placeholder.com/150' %>" class="pet-img">
                    <h3><%= pet.name %></h3>
                    <p>พันธุ์: <%= pet.breed || '-' %></p>
                    <a href="/pet/<%= pet._id %>" class="btn" style="background:#ffb3c1;">📖 เปิดดูไดอารี่</a>
                </div>
            <% }); %>
        </div>
    </div>
</body>
</html>